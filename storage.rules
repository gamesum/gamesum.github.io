rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: public read, owner-only write, max 2 MB, image types only.
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName.matches('^' + request.auth.uid + '\\.(png|jpg|jpeg|webp)$')
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null
                    && fileName.matches('^' + request.auth.uid + '\\..+');
    }

    match /sequences/{file} {
      allow read: if false;
      allow write: if false;
    }

    // Sequence cover/gallery photos: public read, authed write, image only, 2 MB cap.
    match /sequence_photos/{sequenceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
