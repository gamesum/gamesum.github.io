rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: public read, owner-only write to <uid>.jpg, 1 MB cap,
    // JPEG only. Client compresses to ~512px JPEG before upload. Owner may
    // delete any legacy variant (.png/.jpeg/.webp) under their uid.
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null
                    && fileName.matches('^' + request.auth.uid + '\\.(png|jpg|jpeg|webp)$');
    }

    // Raw sequence assets (.fseq, .mp3): server-side only via signed URLs.
    match /sequences/{file} {
      allow read: if false;
      allow write: if false;
    }

    // Sequence cover/gallery photos: public read; any authed user can write
    // images that meet the size/type/name constraints. We don't gate on the
    // creatorUid via cross-service Firestore lookup because (a) sequenceIds
    // are UUIDv4 / unguessable, (b) cross-service Firestore reads from
    // storage.rules are fragile in some bucket configurations, and (c) the
    // auth + size + type + filename guards still bound abuse. Server-side
    // userDeleteUpload + adminDeleteUpload still own the destructive paths.
    match /sequence_photos/{sequenceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)')
                   && fileName.matches('^[A-Za-z0-9_.-]{1,80}\\.(png|jpg|jpeg|webp)$');
      allow delete: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
