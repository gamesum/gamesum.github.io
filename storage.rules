rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures: public read, owner-only write to <uid>.jpg, 1 MB cap,
    // JPEG only. Client compresses to ~512px JPEG before upload. Owner may
    // delete any legacy variant (.png/.jpeg/.webp) under their uid.
    match /profile_pictures/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 1 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
      allow delete: if request.auth != null
                    && fileName.matches('^' + request.auth.uid + '\\.(png|jpg|jpeg|webp)$');
    }

    // Raw sequence assets (.fseq, .mp3): server-side only via signed URLs.
    match /sequences/{file} {
      allow read: if false;
      allow write: if false;
    }

    // Sequence cover/gallery photos: public read.
    // Write rules are split into two cases because photos are uploaded BEFORE
    // the sequence Firestore doc is created (uploadSequence reads the photo
    // URLs from the request body):
    //   - If no doc exists yet, allow any authed user (sequenceIds are
    //     UUIDv4, unguessable; collision risk is negligible).
    //   - Once the doc exists, only the recorded creator may write/delete.
    // The auth+size+type+name constraints still bound abuse in either path.
    match /sequence_photos/{sequenceId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && (
                     !firestore.exists(/databases/(default)/documents/sequences/$(sequenceId))
                     || firestore.get(/databases/(default)/documents/sequences/$(sequenceId)).data.creatorUid == request.auth.uid
                   )
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)')
                   && fileName.matches('^[A-Za-z0-9_-]{1,64}\\.(png|jpg|jpeg|webp)$');
      allow delete: if request.auth != null
                    && (
                      !firestore.exists(/databases/(default)/documents/sequences/$(sequenceId))
                      || firestore.get(/databases/(default)/documents/sequences/$(sequenceId)).data.creatorUid == request.auth.uid
                    );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
