rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users directory: self or admin can read, only admin can write (via Admin SDK).
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      // Owner may self-update only photoURL, and only to an allowed host.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() < 2048
                    && request.resource.data.photoURL.matches('^https://(firebasestorage\\.googleapis\\.com|lh[0-9]\\.googleusercontent\\.com|.*\\.googleusercontent\\.com)/.*');

      match /download_tokens/{tokenId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Sequences: published rows are public-read. All writes are server-side
    // via Cloud Functions (Admin SDK). Creators may patch a tight allow-list
    // of UI-editable fields on their own doc only.
    match /sequences/{seqId} {
      allow read:   if resource.data.status == "published"
                    || isAdmin()
                    || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      allow create: if false;
      allow delete: if isAdmin();
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.creatorUid == request.auth.uid
                        && request.resource.data.creatorUid == resource.data.creatorUid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name','title','description','tags','coverPhotoIndex','photos','coverPhoto','updatedAt']));

      // Reviews + ratings: public read so the store can show stars and
      // comments. All writes go through submitReview / deleteOwnReview
      // Cloud Functions which enforce profanity filter and ownership.
      match /reviews/{reviewerUid} {
        allow read:  if true;
        allow write: if false;
      }
    }

    // Purchases: buyer reads own, admin reads all. Cloud Functions write only.
    match /purchases/{docId} {
      allow read:  if isAdmin()
                   || (request.auth != null && request.auth.uid == resource.data.userId);
      allow write: if false;
    }

    // Creator earnings: creator reads own, admin reads all.
    match /creator_earnings/{creatorId} {
      allow read:  if isAdmin()
                   || (request.auth != null && request.auth.uid == creatorId);
      allow write: if false;

      match /ledger/{entryId} {
        allow read:  if isAdmin()
                     || (request.auth != null && request.auth.uid == creatorId);
        allow write: if false;
      }
    }

    // Disputes: admin only.
    match /disputes/{disputeId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Admin audit log: admin read only. Admin SDK writes only.
    match /admin_audit/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // DMCA notices: anonymous public legal-notice submission with shape validation
    // to limit spam/abuse. Admins read/mutate via Cloud Functions.
    match /dmca_notices/{noticeId} {
      allow read:   if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
                        'reporterName','reporterEmail','reporterAddress','reporterPhone',
                        'copyrightedWork','infringingUrl','goodFaithStatement',
                        'accuracyStatement','signature','submittedAt','status','userAgent'
                      ])
                    && request.resource.data.reporterName is string
                    && request.resource.data.reporterName.size() > 0
                    && request.resource.data.reporterName.size() < 200
                    && request.resource.data.reporterEmail is string
                    && request.resource.data.reporterEmail.size() < 320
                    && request.resource.data.reporterEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.copyrightedWork is string
                    && request.resource.data.copyrightedWork.size() < 5000
                    && request.resource.data.infringingUrl is string
                    && request.resource.data.infringingUrl.size() < 2000
                    && request.resource.data.signature is string
                    && request.resource.data.signature.size() < 200;
      allow update, delete: if false;
    }

    // Contact form submissions: anonymous public create with shape validation
    // to limit spam/abuse. Admins read via the admin console only.
    match /contact_submissions/{submissionId} {
      allow read:   if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
                        'name','email','phone','address','interest','message',
                        'addressStreet','addressCity','addressState','addressZip',
                        'marketingOptIn','source','submittedAt','status','userAgent',
                        'attribution'
                      ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 320
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 40
                    && request.resource.data.address is string
                    && request.resource.data.address.size() < 300
                    && request.resource.data.interest is string
                    && request.resource.data.interest.size() < 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000
                    && (!('addressStreet' in request.resource.data) || (request.resource.data.addressStreet is string && request.resource.data.addressStreet.size() < 200))
                    && (!('addressCity' in request.resource.data) || (request.resource.data.addressCity is string && request.resource.data.addressCity.size() < 100))
                    && (!('addressState' in request.resource.data) || (request.resource.data.addressState is string && request.resource.data.addressState.size() < 50))
                    && (!('addressZip' in request.resource.data) || (request.resource.data.addressZip is string && request.resource.data.addressZip.size() < 20))
                    && (!('marketingOptIn' in request.resource.data) || request.resource.data.marketingOptIn is bool)
                    && (!('source' in request.resource.data) || request.resource.data.source in ['contact form', 'landing page', 'controller upgrade page'])
                    // Ad attribution (utm_* / fbclid) captured from the landing URL.
                    // Bounded: a map of short strings, so a crafted URL cannot
                    // write an unbounded blob into the lead document.
                    && (!('attribution' in request.resource.data) || (request.resource.data.attribution is map && request.resource.data.attribution.size() < 12));
      allow update, delete: if false;
    }

    // GDPR/CCPA data requests: requester reads own, admin reads all.
    match /data_requests/{requestId} {
      allow read:  if isAdmin()
                   || (request.auth != null && request.auth.uid == resource.data.uid);
      allow write: if false;
    }

    // Feedback: server-side only. Admins read via adminReplyFeedback.
    match /feedback/{feedbackId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
