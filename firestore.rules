rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Users directory: self or admin can read, only admin can write.
    // (Cloud Functions using the Admin SDK bypass these rules.)
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();

      // Download tokens are written by Cloud Functions only; user may read own.
      match /download_tokens/{tokenId} {
        allow read:  if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Sequences (aka "uploads"): published rows are public-read.
    // Admins can read all. Creators may write their own doc; admin can write any.
    match /sequences/{seqId} {
      allow read:  if resource.data.status == "published"
                   || isAdmin()
                   || (request.auth != null && resource.data.creatorUid == request.auth.uid);
      allow write: if isAdmin()
                   || (request.auth != null && request.auth.uid == resource.data.creatorUid);
    }

    // Purchases: buyer can read their own, admin can read all.
    // Writes are Cloud Functions only.
    match /purchases/{docId} {
      allow read:  if isAdmin()
                   || (request.auth != null && request.auth.uid == resource.data.userId);
      allow write: if false;
    }

    // Creator earnings: creator can read their own record; admin can read all.
    match /creator_earnings/{creatorId} {
      allow read:  if isAdmin()
                   || (request.auth != null && request.auth.uid == creatorId);
      allow write: if false;

      // Ledger entries (refunds, disputes, sales): creator reads own, admin reads all.
      // Cloud Functions write only.
      match /ledger/{entryId} {
        allow read:  if isAdmin()
                     || (request.auth != null && request.auth.uid == creatorId);
        allow write: if false;
      }
    }

    // Disputes: admin read/write only. Cloud Functions write via Admin SDK.
    match /disputes/{disputeId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Admin audit log: admin read only. Cloud Functions write via Admin SDK.
    match /admin_audit/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
